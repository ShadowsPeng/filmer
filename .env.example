# ===== Filmer 后端通用环境变量 =====
# 复制到 packages/server/.env 后按需修改。

# === 数据库 ===
# 本地默认 sqlite, 零依赖。生产切 mysql 改 packages/server/prisma/schema.prisma 的 provider + DATABASE_URL 即可。
DATABASE_URL="file:./dev.db"

# === JWT ===
JWT_SECRET="dev-secret-change-me-in-production"
JWT_EXPIRES_IN="7d"

# === 服务端口 ===
SERVER_PORT=3000

# === 微信支付 (V3 API) ===
# 三档模式:local-mock / staging-live / production-live
# - local-mock: 不访问微信, 后端返回结构化 mock 数据
# - staging-live: 真实商户号联调(白名单测试 OpenID + 0.01元小额付款)
# - production-live: 生产环境
WX_PAY_MODE="local-mock"

# 以下字段在 staging-live / production-live 时必填
WECHAT_APPID="wx0000000000000000"
WECHAT_APPSECRET=""
WECHAT_MCHID="1234567890"
WECHAT_API_V3_KEY=""                                  # 32 字节
WECHAT_MERCHANT_CERT_SERIAL_NO=""
WECHAT_MERCHANT_CERT_PATH=""                            # 绝对路径
WECHAT_MERCHANT_KEY_PATH=""                             # 绝对路径

# 微信支付公钥及其公钥 ID(回调验签)
WECHAT_PUBLIC_KEY_PATH=""
WECHAT_PUBLIC_KEY_ID=""

# V3 API 基础地址(默认正式端点)
WECHAT_API_BASE="https://api.mch.weixin.qq.com"

# 微信支付回调地址(staging/production 必须公网 HTTPS)
WX_PAY_NOTIFY_URL="https://your-domain.com/api/payment/notify"

# === 订单策略 ===
ORDER_PAY_EXPIRE_MINUTES=30
